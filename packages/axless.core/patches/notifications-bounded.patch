+    function _writeNotifications() {
         const limitedList = limitNotificationsPerSummary(root.list);
         notifFileView.setText(stringifyList(limitedList));
     }
 
+    Timer {
+        id: _listSaveTimer
+        interval: 1200
+        onTriggered: root._writeNotifications()
+    }
+
+    // axless.core: bound the in-memory history. The per-summary limiter only
+    // capped what got written to disk; root.list itself grew without limit and
+    // every derived binding (popupList, groupsByAppName, appNameList) rescans
+    // it on each change.
+    readonly property int maxHistory: 200
+
+    function _appendNotification(notif) {
+        const next = [...root.list, notif];
+        if (next.length > root.maxHistory)
+            next.splice(0, next.length - root.maxHistory);
+        root.list = next;
+    }
