+++ b/modules/services/Visibilities.qml
@@ -168,6 +168,20 @@ Singleton {
     }
 
     function setActiveModule(moduleName) {
+        // axless.core: when Hax is the selected launcher, "launcher" and ""
+        // refer to the Hax spotlight instead of the notch launcher. Putting
+        // the branch here covers every caller at once - the bar's launcher
+        // button, UserInfo, the keybinds, the IPC command and the dashboard -
+        // which each call setActiveModule directly rather than going through
+        // GlobalShortcuts.toggleLauncher().
+        if (Config.notch && Config.notch.launcher === "hax") {
+            if (moduleName === "launcher")
+                GlobalStates.haxVisible = true;
+            else if (moduleName === "")
+                GlobalStates.haxVisible = false;
+            return;
+        }
+
         const focusedMonitor = AxctlService.focusedMonitor;
         if (!focusedMonitor)
             return;
