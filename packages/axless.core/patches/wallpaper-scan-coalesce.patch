+    // ── axless.core: coalesced rescan ──────────────────────────────────
+    //
+    // There is one watcher for the wallpaper root plus one per subdirectory,
+    // and Quickshell's FileView.watchChanges also watches the *parent* of its
+    // path. So every subdirectory watcher is watching the wallpaper root too,
+    // and a single file appearing or disappearing at the root fires all of
+    // them at once. Each one used to kick off its own `find -L` over the
+    // whole tree, plus a second `find -d`, plus a thumbnail regeneration.
+    //
+    // With a wallpaper library of any size that turned one file operation into
+    // dozens of concurrent tree walks over tens of thousands of entries, all
+    // competing with the GUI thread for CPU - which is what made opening this
+    // section feel like the machine was stalling.
+    //
+    // Now every watcher funnels through one coalescing point: a scan already
+    // in flight is never restarted, and requests arriving while it runs
+    // collapse into a single follow-up pass.
+    property bool _scanInFlight: false
+    property bool _scanAgain: false
+
+    function requestRescan(reason) {
+        if (_scanInFlight) {
+            _scanAgain = true;
+            return;
+        }
+        _scanInFlight = true;
+        scanWallpapers.running = true;
+        scanSubfoldersProcess.running = true;
+    }
+
+    function _rescanSettled() {
+        _scanInFlight = false;
+        if (_scanAgain) {
+            _scanAgain = false;
+            requestRescan("coalesced follow-up");
+        }
+    }
+
+    function requestThumbnailRegen() {
+        if (delayedThumbnailGen.running)
+            delayedThumbnailGen.restart();
+        else
+            delayedThumbnailGen.start();
+    }
+
