diff --git a/modules/services/GlobalShortcuts.qml b/modules/services/GlobalShortcuts.qml
index e420049..3d2b5c1 100644
--- a/modules/services/GlobalShortcuts.qml
+++ b/modules/services/GlobalShortcuts.qml
@@ -104,6 +104,13 @@ QtObject {
 
             // Brightness (routes through the same setBrightness path the slider uses,
             // avoiding a per-press fork of the Go CLI + qs ipc chain).
+            // axless.core: volume now goes through the shell so the global
+            // cooldown can dedupe it. It used to be a direct `exec wpctl` bind
+            // that never reached here, which is why a laptop whose two
+            // keyboards both send XF86AudioRaiseVolume moved the volume twice.
+            case "volume-up": Audio.incrementVolume(); break;
+            case "volume-down": Audio.decrementVolume(); break;
+            case "volume-mute": Audio.toggleMute(); break;
             case "brightness-up": Brightness.increaseAll(); break;
             case "brightness-down": Brightness.decreaseAll(); break;
 
