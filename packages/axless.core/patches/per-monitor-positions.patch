diff --git a/modules/dock/DockContent.qml b/modules/dock/DockContent.qml
index 474b8a6..ba8b659 100644
--- a/modules/dock/DockContent.qml
+++ b/modules/dock/DockContent.qml
@@ -29,9 +29,21 @@ Item {
     readonly property bool isDefault: theme === "default"
 
     // Position configuration with fallback logic to avoid bar collision
-    readonly property string userPosition: Config.dock?.position ?? "bottom"
-    readonly property string barPosition: Config.bar?.position ?? "top"
-    readonly property string notchPosition: Config.notchPosition ?? "top"
+    // axless.core: per-monitor overrides, see monitors.json. The dock reads
+    // all three because its final position is derived from where the bar and
+    // notch sit on *this* monitor, not globally.
+    readonly property string userPosition: {
+        const override = PerMonitorConfig.resolve(screen.name, "dock", "position", "")
+        return override || (Config.dock?.position ?? "bottom")
+    }
+    readonly property string barPosition: {
+        const override = PerMonitorConfig.resolve(screen.name, "bar", "position", "")
+        return override || (Config.bar?.position ?? "top")
+    }
+    readonly property string notchPosition: {
+        const override = PerMonitorConfig.resolve(screen.name, "notch", "position", "")
+        return override || (Config.notchPosition ?? "top")
+    }
 
     // Effective position
     readonly property string position: {
