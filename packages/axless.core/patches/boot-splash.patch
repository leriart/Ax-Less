diff --git a/shell.qml b/shell.qml
index 888996d..d74d4d3 100644
--- a/shell.qml
+++ b/shell.qml
@@ -311,4 +311,100 @@ ShellRoot {
             _ = GameModeClient.toggled;
         }
     }
+
+    // ── axless.core: boot splash ────────────────────────────────────
+    // A black full-screen overlay holding the shell logo, held long enough
+    // to cover the first-frame gap of a cold start, then faded out and torn
+    // down entirely so it costs nothing afterwards.
+    //
+    // Driven entirely by Config.animDuration / Easing.OutCubic rather than a
+    // separate token set, so it matches every other transition in the shell
+    // and snaps instantly when game mode zeroes the animation duration.
+    Loader {
+        id: bootSplash
+        active: Config.theme.showSplash !== false
+        sourceComponent: Component {
+            Variants {
+                model: Quickshell.screens
+                PanelWindow {
+                    required property ShellScreen modelData
+                    screen: modelData
+                    anchors {
+                        top: true
+                        left: true
+                        right: true
+                        bottom: true
+                    }
+                    color: "#000000"
+                    WlrLayershell.layer: WlrLayer.Overlay
+                    WlrLayershell.namespace: "ambxst:splash-overlay"
+                    WlrLayershell.keyboardFocus: WlrKeyboardFocus.None
+                    exclusionMode: ExclusionMode.Ignore
+
+                    Item {
+                        id: splashBg
+                        anchors.fill: parent
+                        opacity: splashVisible ? 1 : 0
+
+                        property bool splashVisible: !splashDone
+                        property bool splashDone: false
+
+                        // Config.theme.splashDuration is in ms; clamped so a
+                        // stray 0 or 50 does not flash a single frame.
+                        readonly property int splashDuration:
+                            Math.max(600, Config.theme.splashDuration || 1800)
+
+                        // Gentle scale-in: the logo settles rather than
+                        // appearing at full size, which covers the first
+                        // frame of the panel tree without feeling like an
+                        // animation the user has to wait through.
+                        Image {
+                            id: splashLogo
+                            anchors.centerIn: parent
+                            width: Math.min(parent.width, parent.height) * 0.42
+                            height: width
+                            source: "assets/ambxst/ambxst-logo.svg"
+                            fillMode: Image.PreserveAspectFit
+                            opacity: logoIn ? 1 : 0
+                            scale: logoIn ? 1 : 0.94
+
+                            property bool logoIn: false
+
+                            Behavior on opacity {
+                                NumberAnimation {
+                                    duration: Config.animDuration
+                                    easing.type: Easing.OutCubic
+                                }
+                            }
+                            Behavior on scale {
+                                NumberAnimation {
+                                    duration: Config.animDuration
+                                    easing.type: Easing.OutCubic
+                                }
+                            }
+
+                            Component.onCompleted: logoIn = true
+                        }
+
+                        // Start the fade slightly before the teardown so the
+                        // overlay is never seen popping out of existence.
+                        Timer {
+                            interval: splashBg.splashDuration - Math.min(400, Config.animDuration)
+                            running: true
+                            onTriggered: splashBg.splashDone = true
+                        }
+
+                        Timer {
+                            interval: splashBg.splashDuration
+                            running: true
+                            onTriggered: {
+                                splashLogo.source = ""
+                                bootSplash.active = false
+                            }
+                        }
+                    }
+                }
+            }
+        }
+    }
 }
