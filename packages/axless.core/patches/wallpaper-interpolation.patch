-        }
-    }
-
-    AudioOutput {
-        id: mutedAudio
-        muted: true
-        volume: 0
-    }
-
-    Item {
-        id: paletteSourceItem
-        visible: true
-        width: videoWallpaper.optimizedPalette.length
-        height: 1
-        opacity: 0
-
-        Row {
-            anchors.fill: parent
-            Repeater {
-                model: videoWallpaper.optimizedPalette
-                Rectangle {
-                    width: 1
-                    height: 1
-                    color: Colors[modelData]
-                }
-            }
-        }
-    }
-
-    ShaderEffectSource {
-        id: paletteTextureSource
-        sourceItem: paletteSourceItem
-        hideSource: true
-        visible: false
-        smooth: false
-        recursive: false
-    }
-
