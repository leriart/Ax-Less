diff --git a/modules/widgets/dashboard/wallpapers/WallpapersTab.qml b/modules/widgets/dashboard/wallpapers/WallpapersTab.qml
index 195fd45..618b4af 100644
--- a/modules/widgets/dashboard/wallpapers/WallpapersTab.qml
+++ b/modules/widgets/dashboard/wallpapers/WallpapersTab.qml
@@ -764,6 +764,181 @@ FocusScope {
                                     }
                                 }
                             }
+
+            // axless.core: interpolation toggle + frame multiplier, sitting
+            // immediately after the tint control. Modelled on NothingLess: a
+            // checkable tile that reveals an x2..x5 selector only while it is
+            // on, because a disabled multiplier is noise.
+            Item {
+                id: interpolationContainer
+                Layout.preferredWidth: interpolationToggle.width
+                                      + (interpolationMultiplier.visible ? interpolationMultiplier.width + 6 : 0)
+                Layout.preferredHeight: 48
+
+                property bool checked: GlobalStates.wallpaperManager
+                                       ? GlobalStates.wallpaperManager.interpolationEnabled
+                                       : false
+
+                StyledRect {
+                    id: interpolationToggle
+                    anchors.left: parent.left
+                    anchors.top: parent.top
+                    anchors.bottom: parent.bottom
+                    width: 100
+                    radius: Styling.radius(4)
+                    variant: interpolationContainer.checked ? "primary" : "pane"
+
+                    Behavior on variant {
+                        enabled: Config.animDuration > 0
+                        NumberAnimation {
+                            duration: Config.animDuration / 2
+                            easing.type: Easing.OutQuart
+                        }
+                    }
+
+                    RowLayout {
+                        anchors.fill: parent
+                        anchors.margins: 4
+                        spacing: 4
+
+                        Rectangle {
+                            Layout.fillWidth: true
+                            Layout.fillHeight: true
+                            color: Colors.background
+                            radius: Styling.radius(0)
+
+                            Text {
+                                anchors.fill: parent
+                                text: I18n.t("wallpapers.interpolation")
+                                color: Colors.overSurface
+                                font.family: Config.theme.font
+                                font.pixelSize: Config.theme.fontSize
+                                font.weight: Font.Medium
+                                verticalAlignment: Text.AlignVCenter
+                                leftPadding: 8
+                                elide: Text.ElideRight
+                            }
+                        }
+
+                        Item {
+                            Layout.preferredWidth: 40
+                            Layout.preferredHeight: 40
+
+                            property bool checked: interpolationContainer.checked
+
+                            Rectangle {
+                                anchors.fill: parent
+                                radius: Styling.radius(0)
+                                color: Colors.background
+                                visible: !parent.checked
+                            }
+
+                            StyledRect {
+                                variant: "primary"
+                                anchors.fill: parent
+                                radius: Styling.radius(0)
+                                visible: parent.checked
+                                opacity: parent.checked ? 1.0 : 0.0
+
+                                Behavior on opacity {
+                                    enabled: Config.animDuration > 0
+                                    NumberAnimation {
+                                        duration: Config.animDuration / 2
+                                        easing.type: Easing.OutQuart
+                                    }
+                                }
+
+                                Text {
+                                    anchors.centerIn: parent
+                                    text: Icons.accept
+                                    color: Styling.srItem("primary")
+                                    font.family: Icons.font
+                                    font.pixelSize: 20
+                                    scale: parent.checked ? 1.0 : 0.0
+
+                                    Behavior on scale {
+                                        enabled: Config.animDuration > 0
+                                        NumberAnimation {
+                                            duration: Config.animDuration / 2
+                                            easing.type: Easing.OutBack
+                                            easing.overshoot: 1.5
+                                        }
+                                    }
+                                }
+                            }
+                        }
+                    }
+
+                    MouseArea {
+                        anchors.fill: parent
+                        cursorShape: Qt.PointingHandCursor
+                        onClicked: {
+                            if (GlobalStates.wallpaperManager)
+                                GlobalStates.wallpaperManager.interpolationEnabled = !interpolationContainer.checked;
+                        }
+                    }
+                }
+
+                // x2 .. x5, shown only while interpolation is on.
+                Rectangle {
+                    id: interpolationMultiplier
+                    anchors.left: interpolationToggle.right
+                    anchors.leftMargin: 6
+                    anchors.top: parent.top
+                    anchors.bottom: parent.bottom
+                    width: 62
+                    radius: Styling.radius(4)
+                    color: Colors.background
+                    visible: interpolationContainer.checked
+
+                    Behavior on opacity {
+                        enabled: Config.animDuration > 0
+                        NumberAnimation {
+                            duration: Config.animDuration / 2
+                            easing.type: Easing.OutQuart
+                        }
+                    }
+
+                    Text {
+                        id: multiplierLabel
+                        anchors.fill: parent
+                        anchors.leftMargin: 8
+                        anchors.rightMargin: 20
+                        verticalAlignment: Text.AlignVCenter
+                        color: Colors.overSurface
+                        font.family: Config.theme.font
+                        font.pixelSize: Config.theme.fontSize
+                        font.weight: Font.Medium
+                        text: "x" + (GlobalStates.wallpaperManager
+                                     ? GlobalStates.wallpaperManager.interpolationMultiplier
+                                     : 2)
+                    }
+
+                    Text {
+                        anchors.right: parent.right
+                        anchors.rightMargin: 6
+                        anchors.verticalCenter: parent.verticalCenter
+                        text: Icons.chevronDown
+                        font.family: Icons.font
+                        font.pixelSize: 14
+                        color: Colors.overSurfaceVariant
+                    }
+
+                    // Cycle x2 -> x3 -> x4 -> x5 -> x2. A ComboBox would need
+                    // a popup inside a scrolling tab, which fights the tab's
+                    // own gesture handling; cycling needs no popup at all.
+                    MouseArea {
+                        anchors.fill: parent
+                        cursorShape: Qt.PointingHandCursor
+                        onClicked: {
+                            if (!GlobalStates.wallpaperManager)
+                                return;
+                            var next = (GlobalStates.wallpaperManager.interpolationMultiplier % 5) + 1;
+                            GlobalStates.wallpaperManager.interpolationMultiplier = next;
+                        }
+                    }
+                }
+            }
                         }
                     }
                 }
