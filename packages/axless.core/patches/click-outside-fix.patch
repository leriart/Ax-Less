     function setActiveModule(moduleName) {
+        // axless.core: closing must never depend on knowing the focused
+        // monitor. clearAll() walks every screen and needs no monitor at all -
+        // the focused monitor is only needed to decide which screen to *open*
+        // on. Returning early here meant that whenever the focused monitor was
+        // momentarily unknown, the click-outside (and the notch/dashboard
+        // dismissal, and every popup's) was silently dropped: the panel stayed
+        // open and the only way out was the keyboard shortcut.
+        if (!moduleName) {
+            clearAll();
+            currentActiveModule = "";
+            const monitorOnClose = AxctlService.focusedMonitor;
+            if (monitorOnClose)
+                lastFocusedScreen = monitorOnClose.name;
+            return;
+        }
+
         const focusedMonitor = AxctlService.focusedMonitor;
         if (!focusedMonitor)
             return;
@@ -176,12 +192,8 @@ Singleton {
 
         clearAll();
 
-        if (moduleName) {
-            currentActiveModule = moduleName;
-            applyActiveModuleToScreen(focusedScreenName);
-        } else {
-            currentActiveModule = "";
-        }
+        currentActiveModule = moduleName;
+        applyActiveModuleToScreen(focusedScreenName);
 
         lastFocusedScreen = focusedScreenName;
     }
