@@ -56,9 +56,17 @@ Singleton {
 
     property int subscriptionHandle: -1
 
-    // Subscription only lives while the dashboard Metrics tab is open,
-    // preserving the original resource-saving behaviour (no dGPU polling).
-    readonly property bool monitoringActive: GlobalStates.dashboardOpen && GlobalStates.dashboardCurrentTab === 2 && root.validDisks.length > 0
+    // Subscription only lives while something is actually displaying the
+    // numbers - originally just the dashboard Metrics tab, which preserved
+    // the resource-saving behaviour (no dGPU polling while idle).
+    //
+    // axless.core widens this to also cover the notch metrics, otherwise
+    // those would render against a deactivated subscription and always show
+    // the initial zeros.
+    readonly property bool monitoringActive:
+        ((GlobalStates.dashboardOpen && GlobalStates.dashboardCurrentTab === 2)
+         || (Config.notch && Config.notch.showMetrics === true))
+        && root.validDisks.length > 0
 
     onMonitoringActiveChanged: {
         if (monitoringActive) activateMonitor();
