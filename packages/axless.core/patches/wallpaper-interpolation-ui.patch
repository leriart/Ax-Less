diff --git a/modules/widgets/dashboard/wallpapers/WallpapersTab.qml b/modules/widgets/dashboard/wallpapers/WallpapersTab.qml
--- a/modules/widgets/dashboard/wallpapers/WallpapersTab.qml
+++ b/modules/widgets/dashboard/wallpapers/WallpapersTab.qml
@@ -769,6 +769,152 @@
                 }
             }
 
+            // axless.core: interpolation toggle + frame multiplier, right
+            // after the tint control. Same pattern as NothingLess: a tile that
+            // checks itself and reveals an x2..x5 selector only while on.
+            Item {
+                id: interpolationContainer
+                Layout.preferredWidth: interpolationToggle.width
+                                      + (interpolationMultiplierChip.visible ? interpolationMultiplierChip.width + 6 : 0)
+                Layout.preferredHeight: 48
+
+                readonly property bool checked: GlobalStates.wallpaperManager
+                                                 ? GlobalStates.wallpaperManager.interpolationEnabled
+                                                 : false
+
+                StyledRect {
+                    id: interpolationToggle
+                    anchors.left: parent.left
+                    anchors.top: parent.top
+                    anchors.bottom: parent.bottom
+                    width: 148
+                    radius: Styling.radius(4)
+                    variant: interpolationContainer.checked ? "primary" : "pane"
+
+                    RowLayout {
+                        anchors.fill: parent
+                        anchors.margins: 4
+                        spacing: 4
+
+                        Rectangle {
+                            Layout.fillWidth: true
+                            Layout.fillHeight: true
+                            color: Colors.background
+                            radius: Styling.radius(0)
+
+                            Text {
+                                anchors.fill: parent
+                                text: I18n.t("wallpapers.interpolation")
+                                color: Colors.overSurface
+                                font.family: Config.theme.font
+                                font.pixelSize: Config.theme.fontSize
+                                font.weight: Font.Medium
+                                verticalAlignment: Text.AlignVCenter
+                                leftPadding: 8
+                            }
+                        }
+
+                        Item {
+                            Layout.preferredWidth: 40
+                            Layout.preferredHeight: 40
+                            readonly property bool checked: interpolationContainer.checked
+
+                            Rectangle {
+                                anchors.fill: parent
+                                radius: Styling.radius(0)
+                                color: Colors.background
+                                visible: !parent.checked
+                            }
+
+                            StyledRect {
+                                variant: "primary"
+                                anchors.fill: parent
+                                radius: Styling.radius(0)
+                                visible: parent.checked
+                                opacity: parent.checked ? 1 : 0
+
+                                Behavior on opacity {
+                                    enabled: Config.animDuration > 0
+                                    NumberAnimation {
+                                        duration: Config.animDuration / 2
+                                        easing.type: Easing.OutCubic
+                                    }
+                                }
+
+                                Text {
+                                    anchors.centerIn: parent
+                                    text: Icons.accept
+                                    color: Styling.srItem("primary")
+                                    font.family: Icons.font
+                                    font.pixelSize: 20
+                                    scale: parent.checked ? 1 : 0
+                                }
+                            }
+                        }
+                    }
+
+                    MouseArea {
+                        anchors.fill: parent
+                        cursorShape: Qt.PointingHandCursor
+                        onClicked: {
+                            if (GlobalStates.wallpaperManager)
+                                GlobalStates.wallpaperManager.interpolationEnabled = !interpolationContainer.checked;
+                        }
+                    }
+                }
+
+                // x2 .. x5, shown only while interpolation is on. Clicking
+                // cycles rather than opening a ComboBox: a popup inside a
+                // scrolling tab fights the tab's own gesture handling.
+                Rectangle {
+                    id: interpolationMultiplierChip
+                    anchors.left: interpolationToggle.right
+                    anchors.leftMargin: 6
+                    anchors.top: parent.top
+                    anchors.bottom: parent.bottom
+                    width: 62
+                    radius: Styling.radius(4)
+                    color: Colors.background
+                    visible: interpolationContainer.checked
+
+                    Text {
+                        anchors.fill: parent
+                        anchors.leftMargin: 8
+                        anchors.rightMargin: 20
+                        verticalAlignment: Text.AlignVCenter
+                        color: Colors.overSurface
+                        font.family: Config.theme.font
+                        font.pixelSize: Config.theme.fontSize
+                        font.weight: Font.Medium
+                        text: "x" + (GlobalStates.wallpaperManager
+                                     ? GlobalStates.wallpaperManager.interpolationMultiplier
+                                     : 2)
+                    }
+
+                    Text {
+                        anchors.right: parent.right
+                        anchors.rightMargin: 6
+                        anchors.verticalCenter: parent.verticalCenter
+                        text: Icons.chevronDown
+                        font.family: Icons.font
+                        font.pixelSize: 14
+                        color: Colors.overSurfaceVariant
+                    }
+
+                    MouseArea {
+                        anchors.fill: parent
+                        cursorShape: Qt.PointingHandCursor
+                        onClicked: {
+                            if (!GlobalStates.wallpaperManager)
+                                return;
+                            GlobalStates.wallpaperManager.interpolationMultiplier =
+                                (GlobalStates.wallpaperManager.interpolationMultiplier % 5) + 1;
+                        }
+                    }
+                }
+            }
+
+
             // Spacer
             // Item { Layout.fillWidth: true }
 
