+    // axless.core: the bundled bridges ship with the mod, so their paths are
+    // resolved relative to this file.
+    readonly property string _ncBin: Qt.resolvedUrl("../../../mcp/nothingclaw/server").toString().replace("file://", "")
+    readonly property string _ocBin: Qt.resolvedUrl("../../../mcp/opencode/server").toString().replace("file://", "")
+
+    function _addBundled(name, endpoint, binPath) {
+        const existing = AgentStore.listProfiles();
+        for (let i = 0; i < existing.length; i++) {
+            if (existing[i].name === name) {
+                Ai.agentManager.reconnectAgent(existing[i].id);
+                return;
+            }
+        }
+        const p = AgentStore.createBlankProfile(name);
+        p.type = "http-bridge";
+        p.endpoint = endpoint;
+        p.toolsPath = "/tools";
+        p.invokePath = "/tools";
+        p.process = { command: binPath, args: [], cwd: "", env: {} };
+        Ai.agentManager.addConnection(p);
+    }
+
+    function _parseEnv(text) {
+        const env = {};
+        const t = (text || "").trim();
+        if (!t)
+            return env;
+        const parts = t.split(",");
+        for (let i = 0; i < parts.length; i++) {
+            const eq = parts[i].indexOf("=");
+            if (eq > 0)
+                env[parts[i].slice(0, eq).trim()] = parts[i].slice(eq + 1).trim();
+        }
+        return env;
+    }
+
+    function _saveNewAgent() {
+        const name = agName.text.trim();
+        if (!name)
+            return;
+        const argsText = agArgs.text.trim();
+        const args = argsText ? argsText.split(/\s+/) : [];
+        const command = agCommand.text.trim();
+        const p = AgentStore.createBlankProfile(name);
+        p.type = agType.text.trim() || (command ? "mcp-stdio" : "http-bridge");
+        p.endpoint = agEndpoint.text.trim();
+        p.toolsPath = agTools.text.trim() || "/tools";
+        p.invokePath = agInvoke.text.trim() || "/tools";
+        p.command = command;
+        p.args = args;
+        p.process = { command: command, args: args, cwd: "", env: root._parseEnv(agEnv.text) };
+        Ai.agentManager.addConnection(p);
+        agName.text = ""; agEndpoint.text = ""; agCommand.text = "";
+        agArgs.text = ""; agEnv.text = ""; agTools.text = ""; agInvoke.text = "";
+    }
+
+    function _liveFor(id) {
+        const conns = Ai.agentManager.connections || [];
+        for (let i = 0; i < conns.length; i++)
+            if (conns[i].id === id)
+                return conns[i];
+        return null;
+    }
+
+    function _toggleAgent(id) {
+        const live = root._liveFor(id);
+        if (live && (live.status === "connected" || live.status === "connecting"))
+            Ai.agentManager.disconnectAgent(id);
+        else
+            Ai.agentManager.reconnectAgent(id);
+    }
+
