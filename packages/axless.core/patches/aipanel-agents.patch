+    // axless.core: the bundled bridges ship with the mod, so their paths are
+    // resolved relative to this file rather than hardcoded.
+    readonly property string _ncBin: Qt.resolvedUrl("../../../mcp/nothingclaw/server").toString().replace("file://", "")
+    readonly property string _ocBin: Qt.resolvedUrl("../../../mcp/opencode/server").toString().replace("file://", "")
+
+    function _addBundled(name, endpoint, binPath) {
+        const existing = AgentStore.listProfiles();
+        for (let i = 0; i < existing.length; i++) {
+            if (existing[i].name === name) {
+                Ai.agentManager.reconnectAgent(existing[i].id);
+                return;
+            }
+        }
+        const p = AgentStore.createBlankProfile(name);
+        p.type = "http-bridge";
+        p.endpoint = endpoint;
+        p.toolsPath = "/tools";
+        p.invokePath = "/tools";
+        p.process = { command: binPath, args: [], cwd: "", env: {} };
+        Ai.agentManager.addConnection(p);
+    }
+
+    function _liveFor(id) {
+        const conns = Ai.agentManager.connections || [];
+        for (let i = 0; i < conns.length; i++)
+            if (conns[i].id === id)
+                return conns[i];
+        return null;
+    }
+
+    function _toggleAgent(id) {
+        const live = root._liveFor(id);
+        if (live && (live.status === "connected" || live.status === "connecting"))
+            Ai.agentManager.disconnectAgent(id);
+        else
+            Ai.agentManager.reconnectAgent(id);
+    }
