{
  "$schema": "../../../docs/mods/manifest.schema.json",
  "manifestVersion": 1,
  "id": "axless.core",
  "name": "Ax-Less Core",
  "version": "1.0.0",
  "description": "The NothingLess feature set as one Ambxst mod. Includes: a pluggable AI agent platform (MCP / HTTP-bridge / command agents with live tool discovery and a reworked AI engine with real tool-call support), an advanced compositor panel filtered to what the running compositor supports, a per-compositor monitor manager with drag canvas and remembered positions, a video wallpaper engine with GPU motion-vector frame interpolation and smooth crossfade transitions, a selectable Hax launcher (calculator, command mode, file search, timers, plugins) alongside the stock one, a dashboard task board with calendar, per-monitor shell positions, and full en/es/ru translations. Everything is adapted to Ambxst's native services and its own animation model.",
  "license": "AGPL-3.0",
  "author": "Leriart",
  "authorUrl": "https://github.com/leriart",
  "homepage": "https://github.com/leriart/Ax-Less",
  "compatibility": {
    "api": 1,
    "ambxst": ">=1.3.10 <1.4.0",
    "testedBaseCommits": [
      "bc60230283a3822eec2e23c949f44990480d0f43",
      "9a9fb6886138",
      "4a8517b3"
    ]
  },
  "commands": [
    "curl",
    "ollama",
    "axctl",
    "ffmpeg"
  ],
  "permissions": [
    "Replaces the AI engine (Ai.qml) and the assistant sidebar with the agent-capable versions",
    "Spawns MCP servers, HTTP agent processes and command agents as child processes",
    "Executes shell commands and approved tools on the user's system",
    "Reads and writes the system prompt, tool allowlist and agent profile files",
    "Reads provider API keys from the Ambxst keystore",
    "Runs axctl to read compositor capabilities and layouts, and to set window opacity live",
    "Re-applies window opacity on every Ambxst start",
    "Adds compositor and translation configuration keys",
    "Spawns ffmpeg to build downscaled video wallpaper caches",
    "Reads output lists from the compositor and applies runtime-only changes to them via each compositor's own IPC (niri msg, hyprctl keyword, Mango IPC)",
    "Runs hyprctl keyword and reload to apply compositor settings at runtime",
    "Runs niri msg to read and change output configuration at runtime",
    "Polls niri msg / hyprctl / mangoctl to remember monitor positions, re-applies them at startup, and stores the memory in ~/.local/share/ambxst/monitor-layout.json",
    "Adds the Hax launcher as an alternative to the stock launcher, selected from Settings -> Shell -> Notch",
    "Runs shell commands, file searches, system actions (lock / suspend / reboot / poweroff) and plugin scripts from the Hax launcher",
    "Replaces the compositor settings panel with one that shows only what the running compositor supports"
  ],
