diff --git a/config/Config.qml b/config/Config.qml
index b7b39906..d49ff259 100644
--- a/config/Config.qml
+++ b/config/Config.qml
@@ -1187,12 +1187,50 @@ Singleton {
 
         adapter: JsonAdapter {
             property string systemPrompt: "You are a helpful assistant running on a Linux system. You have access to some tools to control the system."
+            // Legacy, kept so existing binds keep resolving. Ignored in
+            // favour of enabledTools.
             property string tool: "none"
+            // axless.agents: explicit tool selection. Empty means "fall back
+            // to toolAllowlist intersected with the active agents' tools".
+            property list<var> enabledTools: []
+            // Names auto-approved without an approval row in the sidebar.
+            // See Ai.qml._shouldAutoApprove.
+            property list<var> toolAllowlist: [
+                "open_url",
+                "list_windows",
+                "list_workspaces",
+                "list_installed_apps",
+                "move_window_to_workspace",
+                "move_windows",
+                "close_app",
+                "open_app"
+            ]
+            property bool toolAutoApprove: true
+            // How many chain nudges to send before abandoning a stalled
+            // tool chain. Mirrors config/defaults/ai.js.
+            property int nudgeBudget: 3
             property list<var> extraModels: []
+            // NOTE: agents used to live here as `property list<var> agents`.
+            // Reassignments to a list<var> inside a JsonAdapter do not
+            // reliably emit onAdapterUpdated, so agent edits never reached
+            // disk. Profiles now live as one JSON file per agent under
+            // XDG_DATA_HOME/ambxst/agents/, owned by the AgentStore
+            // singleton.
             property string defaultModel: "gemini-2.0-flash"
             property int sidebarWidth: 400
             property string sidebarPosition: "right"
             property bool sidebarPinnedOnStartup: false
+            // "chat" (no tools) | "agent" (use tools)
+            property string defaultMode: "agent"
+            // "" = all discovered agents, otherwise an agent id.
+            property string defaultAgentId: ""
+            // Custom OpenAI-compatible provider.
+            property string customEndpoint: ""
+            property string customCurlTemplate: ""
+            // Per-request curl inactivity timeout, in seconds. The
+            // wall-clock deadline is 4x this. Defaults to 240s so a small
+            // local model on CPU has room for its first token.
+            property int requestTimeoutSeconds: 240
         }
     }
 
diff --git a/config/defaults/ai.js b/config/defaults/ai.js
index dd750c91..137fde97 100644
--- a/config/defaults/ai.js
+++ b/config/defaults/ai.js
@@ -1,9 +1,107 @@
 var data = {
-    "systemPrompt": "You are a helpful assistant running on a Linux system. You have access to some tools to control the system.",
+    // ── System prompt ──
+    // The agent layer (AgentToolRegistry) hands the model real tools, so
+    // the prompt has to encode two rules the chat pipeline relies on:
+    //
+    //   1. A multi-step request must run as ONE chain in one turn. A model
+    //      that answers with prose after a read-only tool result and then
+    //      waits looks broken. Ai.qml._buildChainNudge re-prompts it.
+    //   2. An empty completion right after a tool result is never
+    //      acceptable: call the next tool, or confirm in one sentence.
+    //
+    // NOTE: ConfigValidator keeps an existing valid value, so a user who
+    // already has ~/.config/ambxst/config/ai.json keeps the older,
+    // non-agent prompt. Reset the AI section in Settings to pick this up.
+    "systemPrompt":
+        "You are an AI assistant running on a Linux desktop. You can control "
+        + "windows, workspaces, apps, URLs, and the shell.\n\n"
+        + "## Core rules\n"
+        + "- ACT, DON'T NARRATE. Call the tool — do not describe what you "
+        + "would do. The user wants the action to happen, not a recipe.\n"
+        + "- AFTER A TOOL SUCCEEDS: reply with ONE short confirmation "
+        + "('Done — moved to workspace 3', 'Opened'). Do not second-guess "
+        + "or re-verify.\n"
+        + "- AFTER A TOOL FAILS (timeout, error, 'not found'): DO NOT GO "
+        + "SILENT. Retry with a fix (correct args, different tool) OR "
+        + "clearly state what is blocking you. Failure is not a stopping "
+        + "condition.\n"
+        + "- YOU DECLARE WHEN THE JOB IS DONE — not a timer. Keep taking "
+        + "concrete steps while the task still needs them.\n"
+        + "- BIAS TOWARD ACTION. If the user says 'move X to Y', 'open X', "
+        + "'close X' — JUST DO IT. Don't ask for clarification on minor "
+        + "ambiguity. The user can re-prompt if wrong.\n"
+        + "- FOR CASUAL MESSAGES ('hello', 'test', 'thanks', 'yo'): answer "
+        + "normally without tools. Only use tools when the user wants "
+        + "an action performed.\n\n"
+        + "## Multi-step chains (MANDATORY — do NOT pause mid-chain)\n"
+        + "When the user's request requires more than one tool, chain them "
+        + "in the same turn. After EVERY tool result, immediately call the "
+        + "next required tool. Do NOT reply with text in between — text "
+        + "without a follow-up tool call breaks the chain and looks like "
+        + "an empty response to the user.\n\n"
+        + "Concrete chains:\n"
+        + "- 'move X to workspace Y' → list_windows → move_window_to_workspace "
+        + "(or move_windows with app_names or window_ids). Do NOT reply "
+        + "with text after list_windows.\n"
+        + "- 'close X' / 'quit X' → list_windows → close_window (per match) "
+        + "or close_app (by name). Do NOT reply with text after list_windows.\n"
+        + "- 'open X' (NATIVE APP) → list_installed_apps → open_app. Do NOT "
+        + "reply with text after list_installed_apps.\n"
+        + "- 'open X in browser' / 'go to X' / 'browse to X' (WEBSITE) → "
+        + "open_url. Use open_url — NOT open_app — for URLs and websites.\n"
+        + "- 'focus X' → list_windows → focus_window(id).\n\n"
+        + "## Tool selection\n"
+        + "- Read-only tools (list_*) are ALWAYS safe to re-invoke. Their "
+        + "result reflects current system state and changes between calls.\n"
+        + "- Write tools (close, move, open, focus): do NOT call the same "
+        + "tool with the exact same arguments twice in the same turn.\n"
+        + "- DO NOT DESCRIBE COMMANDS IN PROSE. The user wants the action, "
+        + "not a recipe.\n\n"
+        + "## Response style\n"
+        + "- Be concise. One sentence is usually enough.\n"
+        + "- Answer in the user's language.\n"
+        + "- 'Launched in background' / 'Dispatched' = success.\n\n"
+        + "## Empty responses are NEVER acceptable after a tool call\n"
+        + "Some providers return finish_reason=stop with no content right "
+        + "after a tool result. When you receive a tool result, your next "
+        + "response MUST either call the next tool in the chain (preferred), "
+        + "or give a single-sentence confirmation. Never end the turn "
+        + "silently.",
     "tool": "none",
+    // Tool names explicitly enabled by the user. Empty means: fall back to
+    // toolAllowlist intersected with what the active agents advertise.
+    "enabledTools": [],
+    // Auto-approved tool names. Everything else waits for the user in the
+    // sidebar. See Ai.qml._shouldAutoApprove.
+    "toolAllowlist": [
+        "open_url",
+        "list_windows",
+        "list_workspaces",
+        "list_installed_apps",
+        "move_window_to_workspace",
+        "move_windows",
+        "close_app",
+        "open_app"
+    ],
+    "toolAutoApprove": true,
+    // How many times we re-prompt the model with an explicit chain nudge
+    // before giving up on a stalled tool chain.
+    "nudgeBudget": 3,
     "extraModels": [],
     "defaultModel": "gemini-2.0-flash",
     "sidebarWidth": 400,
     "sidebarPosition": "right",
-    "sidebarPinnedOnStartup": false
+    "sidebarPinnedOnStartup": false,
+    // Default mode for new chats: "chat" (no tools) | "agent" (use tools)
+    "defaultMode": "agent",
+    // Default agent binding. "" = all discovered agents.
+    "defaultAgentId": "",
+    // Custom OpenAI-compatible provider endpoint, and an optional full
+    // curl template with {{BODY_PATH}} / {{ENDPOINT}} / {{API_KEY}}.
+    "customEndpoint": "",
+    "customCurlTemplate": "",
+    // Per-request inactivity timeout in seconds, passed to curl --max-time.
+    // The wall-clock deadline is computed separately as 4x this value so a
+    // slow local model can finish its first token.
+    "requestTimeoutSeconds": 240
 }
